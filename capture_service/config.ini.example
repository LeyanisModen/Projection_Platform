; Copy this file to config.ini next to capture_service.py and edit
; the values for each mini-PC. Anything you do not set here falls back
; to the defaults baked into capture_service.py.

[service]
; HTTP server binding. Keep it on loopback so nothing external can hit it.
host = 127.0.0.1
port = 5555

; Camera index (first webcam = 0, second = 1, ...).
camera_index = 0
camera_backend = CAP_ANY

; On-demand /capture size. The OBSBOT Tiny 2 soporta 4K nativo pero
; el driver UVC se queda colgado en read() si le pides 3840x2160 nada
; más abrirla (sleep mode / warm-up). FullHD arranca estable en todos
; los mini-PCs probados y es suficiente para proyección de obra.
capture_width = 1920
capture_height = 1080
jpeg_quality = 95

; On-demand _FOTO / _CHECK captures continuously read frames while the camera
; adapts to the projected white slide. It may finish after the minimum once
; four luminance samples are stable, and always returns by the maximum timeout.
capture_settle_min_seconds = 1.5
capture_settle_max_seconds = 3.0
capture_luminance_tolerance_percent = 3.0

; Orientation applied to every frame before saving/uploading.
; Factory cameras mounted on vertical posts need 180 so the table appears
; upright in Drive/backend evidence. Use 0 for bench/testing setups.
image_rotation = 180

; The admin dashboard is the source of truth for the working window,
; capture interval and per-table rotation. The service loads its last valid
; remote_config.json first, then checks Railway at startup and at 06/09/12/15.
; Only temporary connection failures are retried every 10 minutes.
remote_config_enabled = true
remote_config_url = https://moden.up.railway.app/api/device/config/
remote_config_ack_url = https://moden.up.railway.app/api/device/config-ack/
remote_config_timeout_seconds = 15
remote_config_retry_seconds = 600
remote_config_check_hours = 6,9,12,15


[documentation]
; Set enabled = false to turn the periodic capture loop off entirely.
enabled = true

; Local high-frequency buffer. Documentation photos are written here during
; production so Google Drive does not upload a new image every few seconds.
local_buffer_dir = C:\moden\capture_buffer

; Root folder that Google Drive Desktop is syncing. The service copies buffered
; photos here only during the weekend sync window.
output_dir = G:\Mi unidad\capturas_moden

; Unique id per mesa (subfolder inside output_dir). Format is
; <cliente>_g<N>_mesa<M>, where <cliente> is a short client code
; (fer = Ferralia, …), <N> is the group number within that client
; and <M> is the mesa number inside that group. Mirrors
; the computer name 1-to-1 (FER-G1-MESA1 ↔ fer_g1_mesa1). Examples:
; fer_g1_mesa1, fer_g1_mesa2, fer_g2_mesa3.
mesa_id = fer_g1_mesa1

; Seconds between captures. 20 s during the 06:50-15:00 window produces
; about 1,470 pictures per table and working day.
interval_seconds = 20

; Resolution + quality for the documentation images. FullHD at q=88
; comes out around 350-500 KB per frame.
width = 1920
height = 1080
jpeg_quality = 88

; Periodic documentation pauses instead of deleting a unique copy when either
; limit is reached. Week-old days with a complete copy in G: are purged first.
max_local_gb = 30
min_free_gb = 5

; Weekend publishing. Captures stay local during the working week, then copy
; to G: from Friday after production until early Monday.
sync_enabled = true
sync_start_hour = 1
sync_end_hour = 5
sync_interval_seconds = 1800
sync_weekly_enabled = true
sync_weekly_start_day = FRI
sync_weekly_start_hour = 15
sync_weekly_start_minute = 30
sync_weekly_end_day = MON
sync_weekly_end_hour = 5
sync_weekly_end_minute = 0

; Drive Desktop is deliberately closed during production so its error dialogs
; cannot cover Chrome kiosk. Updates come from GitHub; Drive opens only during
; the extended weekend window that uploads the weekly photo batch.
drive_guard_enabled = true
drive_daily_enabled = false
drive_start_hour = 3
drive_start_minute = 45
drive_stop_hour = 4
drive_stop_minute = 45
drive_weekend_enabled = true
drive_weekend_start_day = FRI
drive_weekend_start_hour = 15
drive_weekend_start_minute = 15
drive_weekend_end_day = MON
drive_weekend_end_hour = 6
drive_weekend_end_minute = 35
drive_guard_interval_seconds = 30

; Delete local buffered day folders only when they already exist in Drive and
; are at least this many days old. Use -1 to keep local copies until max_local_gb.
local_retention_days = 7

; Working window. Outside of it the loop sleeps and nothing is written.
active_days = MON,TUE,WED,THU,FRI
active_start_hour = 6
active_start_minute = 50
active_end_hour = 15
active_end_minute = 0


[sharpness]
; Once per active day (on the first tick of the morning) the service
; grabs a frame and runs a variance-of-Laplacian analysis on it. Low
; variance can mean soft edges, which on a fixed-focus camera may point
; to a dirty lens. The result is exposed in /stats (sharpness_status).
enabled = true

; Variance thresholds. Tune after observing real values on /stats:
;   > threshold_warning      -> status 'ok'
;   >= threshold_blurry      -> status 'warning' (borderline)
;   < threshold_blurry       -> status 'blurry' (likely dirty lens)
; Lower values are more tolerant. Keep these conservative because a
; perfectly clean camera can see low edge variance on plain projected
; backgrounds while exposure settles.
threshold_blurry = 2
threshold_warning = 10

; A low or inconclusive first frame is not final. Retry during the active
; window so the warning can recover once the camera sees a detailed image.
retry_minutes = 15

; If the first frame of the day is too dark or too flat, the service
; reports 'unknown' instead of a false dirty-lens warning.
min_brightness = 18
min_contrast = 8
